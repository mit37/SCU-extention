{
  "manifest_version": 3,
  "name": "SCU Course Companion",
  "version": "0.1.0",
  "description": "See professor ratings, syllabus-based insights, and friends' schedules right on your SCU course pages.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://www.ratemyprofessors.com/*",
    "*://*.scu.edu/*",
    "*://*.myworkday.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": ["*://*.scu.edu/*", "*://*.myworkday.com/*"],
      "js": ["lib/html.js", "lib/detect.js", "content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ]
}
